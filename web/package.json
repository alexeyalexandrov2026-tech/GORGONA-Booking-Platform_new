    "test:management:location": "playwright test tests/location-access.spec.ts",
    "test:delegation:management": "playwright test tests/delegation-management.spec.ts",
    "test:delegation:workspace": "playwright test tests/delegation-workspace.spec.ts"
  },
  "dependencies": {
    "next": "16.3.7",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
