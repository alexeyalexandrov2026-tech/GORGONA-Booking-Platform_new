# AMARKAL Platform — Local Development Environment Example
# Copy to .env for local development ONLY. Never commit real secrets.
# Production secrets live exclusively in Google Cloud Secret Manager.

# --- Core Runtime ---
GBA_ENV=local
GBA_HOST=127.0.0.1
GBA_PORT=8000
GBA_CUSTOMER_WEB_DIR=web/out
GBA_TRUSTED_PROXY=none
# In GCP Cloud Run:
# GBA_ENV=production
# GBA_PRODUCTION_AUTHORIZATION=PA-YYYYMMDD-release-slug
# GBA_TRUSTED_PROXY=google_cloud_lb
# GBA_EDGE_SECRET=<32+ char shared secret injected by Global HTTPS LB>

# --- PostgreSQL 18 ---
# Runtime (non-owner, FORCE RLS enforced) DSN:
GBA_DATABASE_URL=postgresql://gba_runtime:change-me@127.0.0.1:5432/gorgona
GBA_DB_POOL_MIN_SIZE=1
GBA_DB_POOL_MAX_SIZE=15
# Disposable test admin DSN (migrations & pytest only):
GBA_TEST_ADMIN_DSN=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# --- Google Cloud Identity Platform (Zero Microsoft Dependency) ---
GBA_AUTH_ISSUER=https://securetoken.google.com/gorgona-platform-gcp
GBA_AUTH_AUDIENCE=gorgona-platform-gcp
GBA_AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
GBA_AUTH_CLIENT_ID=gorgona-platform-gcp
GBA_AUTH_SCOPE=openid profile email
# Public Firebase browser key & Web OAuth Client ID (for /auth/signin/):
GBA_GOOGLE_IDENTITY_API_KEY=
GBA_GOOGLE_OAUTH_CLIENT_ID=

# --- Stripe US Payments (USD) ---
GBA_STRIPE_SECRET_KEY=
GBA_STRIPE_PUBLISHABLE_KEY=
GBA_STRIPE_WEBHOOK_SECRET=

# --- Resend SMTP Live Email Notifications ---
GBA_NOTIFICATIONS_MODE=sandbox
GBA_EMAIL_PROVIDER=smtp
GBA_SMTP_HOST=smtp.resend.com
GBA_SMTP_PORT=587
GBA_SMTP_USERNAME=resend
GBA_SMTP_PASSWORD=
GBA_SMTP_SENDER=no-reply@amarkal-platform.com

# --- Cloudflare Workers AI (AI Business Architect & Copilot) ---
GBA_AI_PROVIDER=auto
GBA_CF_ACCOUNT_ID=
GBA_CF_API_TOKEN=
GBA_CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GBA_CF_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# --- Cloudflare R2 Brand Media Storage ---
GBA_R2_BUCKET=gorgona-media
GBA_R2_ENDPOINT=
GBA_R2_ACCESS_KEY_ID=
GBA_R2_SECRET_ACCESS_KEY=
